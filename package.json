{
  "name": "hardhat-template",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Distributed Lab",
  "description": "",
  "keywords": [
    "solidity",
    "smart-contracts"
  ],
  "files": [
    "**/*.sol",
    "!mock/**/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npx hardhat build",
    "coverage": "npx hardhat test mocha --coverage",
    "clean": "npx hardhat clean",
    "test": "npx hardhat test mocha",
    "test-all": "npx hardhat migrate && npm run test",
    "private-network": "npx hardhat node",
    "private-network-fork": "npx hardhat node --network ethereumFork",
    "deploy-localhost": "npx hardhat migrate --network localhost",
    "deploy-sepolia": "npx hardhat migrate --network sepolia --verify",
    "deploy-ethereum": "npx hardhat migrate --network ethereum --verify",
    "generate-types": "npx hardhat build --force && npx hardhat gobind",
    "generate-docs": "npx hardhat markup",
    "lint-fix": "npm run lint-sol-fix && npm run lint-ts-fix && npm run lint-json-fix && npm run slippy-check && npm run eslint-check",
    "lint-json-fix": "prettier --write \"./**/*.json\"",
    "lint-ts-fix": "prettier --write \"./**/*.ts\" --ignore-path .prettierignore",
    "lint-sol-fix": "prettier --write \"contracts/**/*.sol\"",
    "slippy-check": "slippy \"./contracts/**/*.sol\"",
    "eslint-check": "eslint . --ext .ts",
    "publish-to-npm": "npm run lint-fix && bash ./scripts/publish.sh --public"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@solarity/solidity-lib": "3.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@solarity/hardhat-gobind": "^2.0.2",
    "@solarity/hardhat-markup": "^2.0.0",
    "@solarity/hardhat-migrate": "4.0.0-rc.0",
    "@solidstate/hardhat-contract-sizer": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "ethers": "^6.17.0",
    "hardhat": "^3.9.1",
    "husky": "^9.1.7",
    "mocha": "^11.7.6",
    "prettier": "^3.9.5",
    "prettier-plugin-solidity": "^2.3.1",
    "slippy": "^0.3.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
